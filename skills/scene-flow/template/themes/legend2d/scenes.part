          <svg class="l2d-v" data-v="footprints" data-pan="-40 40" data-dark="1" viewBox="0 0 1080 1920" aria-hidden="true">
            <g class="cam">
              <rect class="f-night" width="1080" height="1920"/>
              <path class="f-earth-dk ink" d="M0 1080 Q540 980 1080 1100 V1920 H0 Z"/>
              <!-- the lantern's pool of light: a flat lit patch on the ground, kept under the horizon and the prints under the caption band -->
              <ellipse class="f-earth ink" cx="540" cy="1620" rx="440" ry="170"/>
              <g data-m="print-0" data-i="0"><ellipse class="f-soil-dk ink" cx="220" cy="1660" rx="22" ry="40"/></g>
