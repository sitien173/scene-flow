      <div class="scene clip" id="sc-legend" data-start="@@start:legend@@" data-duration="@@dur:legend@@" data-track-index="1">
        <div class="wrap" id="w-legend">
          <!-- One flat vector vignette per vignettes.json entry. data-v must equal the vignette id, data-pan is the
               camera pan in px across the shot, and data-m names a part that stage.part moves as a pure function of time. -->
          <svg class="l2d-v" data-v="village" data-pan="-30 30" viewBox="0 0 1080 1920" aria-hidden="true">
            <g class="cam">
              <rect class="f-sky" width="1080" height="1920"/>
              <circle class="f-straw ink" cx="220" cy="330" r="92"/>
              <path class="f-olive ink" d="M0 1000 L180 880 L360 990 L560 860 L760 980 L940 890 L1080 960 V1100 H0 Z"/>
              <rect class="f-earth" x="0" y="1040" width="1080" height="880"/>
              <path class="f-straw ink" d="M120 880 H320 V1040 H120 Z"/>
              <path class="f-earth-dk ink" d="M100 890 L220 790 L340 890 Z"/>
              <path class="f-straw ink" d="M800 860 H980 V1040 H800 Z"/>
