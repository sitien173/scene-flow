      <div class="scene clip" id="sc-ec" data-start="@@start:ec@@" data-duration="@@dur:ec@@" data-track-index="1">
        <div class="wrap" id="w-ec">
          <img id="ec-logo" src="@@logo@@" alt="">
          <div id="ec-brand">@@brand@@</div>
          <div id="ec-slogan">@@slogan@@</div>
