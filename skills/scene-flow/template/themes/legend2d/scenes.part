          <svg class="l2d-v" data-v="stampede" data-pan="0 0" viewBox="0 0 1080 1920" aria-hidden="true">
            <g class="cam">
              <rect class="f-sky" width="1080" height="1920"/>
              <circle class="f-straw ink" cx="220" cy="300" r="80"/>
              <rect class="f-earth" x="0" y="1080" width="1080" height="840"/>
              <path class="f-earth-dk ink" d="M0 1080 H1080 V1120 H0 Z"/>
              <g data-m="herd">
