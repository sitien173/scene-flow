              <ellipse class="shadow" data-m="boy-shadow" cx="540" cy="1262" rx="96" ry="16"/>
              <g data-m="boy">
                <rect class="f-soil ink" x="508" y="1196" width="28" height="74"/>
                <rect class="f-soil ink" x="544" y="1196" width="28" height="74"/>
