              <rect class="f-earth" x="0" y="1080" width="1080" height="840"/>
              <g data-m="stem-0" data-x="173"><rect class="f-olive ink" x="150" y="700" width="46" height="480"/></g>
              <g data-m="stem-1" data-x="318"><rect class="f-olive ink" x="295" y="640" width="46" height="540"/></g>
