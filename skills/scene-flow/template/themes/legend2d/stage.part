      <script type="module">
        // Resolved by build.py from vignettes.json: [{ id, t, end, in: { kind }, beats }], times in seconds. Hard cuts only.
        // Every frame is a pure function of seek time: no clock, no random numbers, no network.
        const VIGNETTES = @@vignettes@@;
        const svgs = VIGNETTES.map(v => {
          const svg = document.querySelector('svg.l2d-v[data-v="' + v.id + '"]');
          if (!svg) throw new Error("legend2d: no art for vignette " + v.id);
          return svg;
        });
        const watermark = document.getElementById("watermark-top");
        let shown = -1;

        const clamp01 = x => Math.min(1, Math.max(0, x));
        const ease = x => 1 - Math.pow(1 - clamp01(x), 3);
        // a beat pops in: 0 before it, a small overshoot, then 1
        const pop = d => d < 0 ? 0 : d < 0.3 ? 1 + 0.2 * Math.sin(Math.PI * d / 0.3) : 1;
        // a stiff hop: 0.6 s of air per beat at 1.5 Hz, then a hold on the ground
        const hop = t => { const p = (t * 1.5) % 1; return p < 0.6 ? 26 * Math.sin(Math.PI * p / 0.6) : 0; };
        const part = (svg, name) => svg.querySelector('[data-m="' + name + '"]');
        const move = (svg, name, transform) => { const el = part(svg, name); if (el) el.setAttribute("transform", transform); };
        const show = (svg, name, value) => { const el = part(svg, name); if (el) el.setAttribute("opacity", String(value)); };
        const pivot = (x, y, s) => `translate(${x} ${y}) scale(${s}) translate(${-x} ${-y})`;

        const MOTION = {
          village(svg, t) {
            const x = -300 * (1 - ease(t / 0.6));
            move(svg, "boy", `translate(${x} ${-hop(t)})`);
            move(svg, "boy-shadow", `translate(${x} 0)`);
          },
          ridge(svg, t, d, b) {
            for (const el of svg.querySelectorAll('[data-m^="stem-"]')) {
              const x = Number(el.dataset.x);
              const grow = ease((t - (b.bamboo || 0) - 0.12 * Number(el.dataset.m.slice(5))) / 0.5);
              el.setAttribute("transform", `translate(${x} 1180) scale(1 ${grow}) translate(${-x} -1180)`);
            }
          },
          stampede(svg, t, d) {
            move(svg, "herd", `translate(${-350 + 700 * clamp01(t / d)} ${-14 * Math.abs(Math.sin(t * 2 * Math.PI * 2))})`);
          },
          cave(svg, t, d, b) {
            const s = b.hollow === undefined ? 1 : 0.4 + 0.6 * ease((t - b.hollow) / 0.5);
            move(svg, "hollow", pivot(540, 1220, s));
          },
          lantern(svg, t, d, b) {
            const lit = b.lamp === undefined ? 0 : t >= b.lamp ? 1 : 0;
            move(svg, "lamp", pivot(540, 1010, pop(t - (b.lamp || 0))));
            show(svg, "glow", lit);
            part(svg, "glow").setAttribute("r", (300 + 10 * Math.sin(t * 2 * Math.PI * 0.7)).toFixed(3));
          },
          footprints(svg, t) {
            for (const el of svg.querySelectorAll('[data-m^="print-"]')) {
              el.setAttribute("opacity", t >= 0.3 + 0.35 * Number(el.dataset.i) ? "1" : "0");
            }
          },
          dock(svg, t, d, b) {
            const bob = -6 * Math.sin(t * 2 * Math.PI * 0.6);
            move(svg, "boat", `translate(0 ${bob.toFixed(3)}) ` + pivot(540, 1290, pop(t - (b.boat || 0))));
          },
          night(svg, t) {
            show(svg, "lights", (0.7 + 0.3 * Math.sin(t * 2 * Math.PI * 1.2)).toFixed(4));
          },
        };

        function activeIndex(time) {
          let k = 0;
          while (k + 1 < VIGNETTES.length && time >= VIGNETTES[k + 1].t) k++;
          return k;
        }

        function renderAt(time) {
          time = Number.isFinite(time) ? Math.max(0, time) : 0;
          const k = activeIndex(time);
          if (shown !== k) {
            for (let i = 0; i < svgs.length; i++) svgs[i].style.display = i === k ? "block" : "none";
            shown = k;
          }
          const v = VIGNETTES[k];
          const svg = svgs[k];
          const t = time - v.t;
          const d = v.end - v.t;
          const beats = Object.fromEntries(Object.entries(v.beats || {}).map(([name, at]) => [name, at - v.t]));
          // camera: a push-in of 6% across the shot, plus the pan given by data-pan; the art is scaled up
          // by the widest pan so the pan never shows the edge of the 1080 px art
          const [x0, x1] = (svg.dataset.pan || "0 0").split(" ").map(Number);
          const p = clamp01(t / d);
          const overscan = 2 * Math.max(Math.abs(x0), Math.abs(x1)) / 1080;
          svg.querySelector(".cam").setAttribute("transform",
            `translate(${x0 + (x1 - x0) * p} 0) ` + pivot(540, 960, 1 + overscan + 0.06 * p));
          if (MOTION[v.id]) MOTION[v.id](svg, t, d, beats);
          // a light watermark over a night sky (data-dark), the ink one everywhere else, including the CTA and end card
          watermark.classList.toggle("on-dark", svg.dataset.dark === "1" && time < v.end);
        }

        window.addEventListener("hf-seek", event => renderAt(event.detail.time));
        window.__legend2d = { vignettes: VIGNETTES, renderAt };
        renderAt(0);
      </script>
      <div class="watermark" id="watermark-top" aria-hidden="true">
        <img src="@@logo@@" alt="">
        <span>@@brand@@</span>
      </div>
