                <path class="f-tunic ink" d="M494 1076 L452 1172 L470 1180 L506 1098 Z"/>
                <path class="f-tunic ink" d="M586 1076 L628 1172 L610 1180 L574 1098 Z"/>
                <circle class="f-skin ink" cx="461" cy="1176" r="14"/>
                <circle class="f-skin ink" cx="619" cy="1176" r="14"/>
                <rect class="f-soil ink" x="596" y="1120" width="40" height="46" rx="6"/>
                <path class="f-hat ink" d="M478 952 L540 856 L602 952 Z"/>
                <circle class="f-skin ink" cx="540" cy="1000" r="54"/>
                <ellipse class="f-hat ink" cx="540" cy="958" rx="118" ry="22"/>
                <circle class="dot" cx="522" cy="996" r="5"/>
                <circle class="dot" cx="558" cy="996" r="5"/>
                <path class="line ink" d="M524 1030 Q540 1040 556 1030"/>
              </g>
            </g>
          </svg>

          <svg class="l2d-v" data-v="ridge" data-pan="40 -40" viewBox="0 0 1080 1920" aria-hidden="true">
            <g class="cam">
              <rect class="f-sky" width="1080" height="1920"/>
