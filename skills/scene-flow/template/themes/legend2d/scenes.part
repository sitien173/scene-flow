              <!-- the lamp's glow: a flat, lighter night disc behind the ground, not a see-through yellow -->
              <circle class="f-night-lit" data-m="glow" cx="540" cy="1010" r="300" opacity="0"/>
              <path class="f-soil-dk ink" d="M0 1300 Q540 1180 1080 1300 V1920 H0 Z"/>
              <line class="line ink" x1="540" y1="700" x2="540" y2="950"/>
              <g data-m="lamp">
